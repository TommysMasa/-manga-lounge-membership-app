rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStaff == true;
    }

    match /users/{userId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);

      allow create: if isStaff() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['firstName', 'lastName', 'gender', 'dateOfBirth', 'createdAt']) &&
        !request.resource.data.keys().hasAny(['isStaff'])
      );

      allow update: if isStaff() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(['isStaff']) ||
          request.resource.data.isStaff == resource.data.isStaff)
      );

      allow delete: if isStaff() || (isSignedIn() && request.auth.uid == userId);
    }

    // Subscription status mirrored by the RevenueCat webhook.
    // Written only by backend services via Admin SDK (bypasses rules).
    // Clients can read their own status; staff can read all (e.g. to
    // verify membership at the counter). Deletion is allowed for account
    // deletion. No client-side writes: subscription state must only come
    // from payment systems.
    match /subscriptions/{userId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if false;
    }

    // Free guest-pass uses recorded by entry-scanner staff.
    // Pro hosts may read their own uses (to show remaining quota in the app).
    // Only staff can create/update/delete.
    match /guestPassUses/{useId} {
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.hostUid == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    // Soft launch Pro seat counter (limit / activeCount). Written only by
    // the RevenueCat webhook via Admin SDK. Signed-in clients may read so
    // the app can show remaining spots on the Upgrade banner.
    match /config/{docId} {
      allow read: if isSignedIn() && docId == 'proCap';
      allow write: if false;
    }

    match /records/{recordId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /Records/{recordId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.membershipId == request.auth.uid);
      allow delete: if isStaff() || (isSignedIn() && resource.data.membershipId == request.auth.uid);
    }

    match /deletionStats/{month} {
      allow write: if isSignedIn();
      allow read: if isStaff();
    }

    match /surveyResponses/{surveyId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /catalogs/{catalogId} {
      allow read, write: if isStaff() && (catalogId == 'drink' || catalogId == 'goods');
    }

    match /goodsPurchases/{purchaseId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
