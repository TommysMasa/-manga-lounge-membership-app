rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      // Allow read access to own user document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow create only if authenticated and userId matches auth uid
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['firstName', 'lastName', 'gender', 'dateOfBirth', 'createdAt']);

      // Allow update only if authenticated and userId matches
      allow update: if request.auth != null && request.auth.uid == userId;

      // Allow delete only if authenticated and userId matches
      // This is required for account deletion feature (Apple App Store requirement)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Records collection - for visit tracking
    match /Records/{recordId} {
      // Allow read access to own records
      allow read: if request.auth != null && resource.data.membershipId == request.auth.uid;

      // Allow delete for account deletion
      allow delete: if request.auth != null && resource.data.membershipId == request.auth.uid;
    }

    // Deletion statistics - write-only for clients
    match /deletionStats/{month} {
      // Allow write for recording deletion statistics
      allow write: if request.auth != null;
    }

    // Check-in status is managed by staff system (not accessible from user app)
    // This ensures users cannot change their own check-in status
  }
}
